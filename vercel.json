{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/((?!google[0-9a-f]+\\.html$|naver[0-9a-f]+\\.html$).*)", "destination": "https://gonggo.oaksoo.com/$1", "statusCode": 301 }
  ]
}
