{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/pro/:path*", "destination": "https://gonggo.43-202-151-104.sslip.io/pro/", "permanent": false },
    { "source": "/terms/:path*", "destination": "https://gonggo.43-202-151-104.sslip.io/terms/", "permanent": false },
    { "source": "/refund/:path*", "destination": "https://gonggo.43-202-151-104.sslip.io/refund/", "permanent": false },
    { "source": "/privacy/:path*", "destination": "https://gonggo.43-202-151-104.sslip.io/privacy/", "permanent": false }
  ]
}
