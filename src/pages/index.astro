---
import Layout from '../layouts/Layout.astro';
import ListingList from '../components/ListingList.astro';
import TossMiniappLink from '../components/TossMiniappLink.astro';
import Chevron from '../components/Chevron.astro';
import { index, listings, categories, tags, weeks, week, today } from '../adapters/site/data.ts';
import { deadlineTimeOf } from '../domain/freshness.ts';
import { weekLabel } from '../domain/format.ts';
import { deadlineWeek } from '../application/buildSiteIndex.ts';
import { SITE_NAME, IS_AWS } from '../infrastructure/config.ts';

const thisWeek = deadlineWeek(today);
// 마감 임박 = 앞 10행만 보이게 하되, 오늘부터 7일 동안 날짜마다 12행씩 여유로 싣는다 — 빌드 뒤 날이 지나면 지난 행을 걷고 다음 날 행이 올라온다(DAY_SCRIPT data-cap, 하루에 37건이 끝나는 날도 있어 앞 40행만으로는 3일을 못 버틴다)
const soonDays = new Set(Array.from({ length: 7 }, (_, i) => new Date(Date.parse(`${today}T12:00:00Z`) + i * 86_400_000).toISOString().slice(0, 10)));
const perDay = new Map<string, number>();
const soon = index.sorted.filter((l) => l.deadline && soonDays.has(l.deadline) && (perDay.set(l.deadline, (perDay.get(l.deadline) ?? 0) + 1), perDay.get(l.deadline)! <= 12));
const hist: Record<string, number> = {};
for (const l of listings) if (l.deadline) { const k = `${l.deadline}${deadlineTimeOf(l.deadlineTime) ? ` ${deadlineTimeOf(l.deadlineTime)}` : ''}`; hist[k] = (hist[k] ?? 0) + 1; } // 날짜(+시각)별 수 — DAY_SCRIPT가 오늘 지난 만큼 뺀다
const title = `${SITE_NAME} — 공모전·해커톤·지원사업 자격·마감·상금 정리`;
const description = `지금 접수 중인 공모전·해커톤·지원사업 ${listings.length}건의 자격 조건, 마감일, 상금을 공고 원문 그대로 정리했어요. 나이·학생·지역만 고르면 낼 수 있는 공고를 골라 드려요.`;
const site = Astro.site!.href.replace(/\/$/, '');
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: `${site}/`, inLanguage: 'ko-KR' }];
---
<Layout title={title} description={description} path="/" jsonLd={jsonLd} bottomCta={{ href: '/check/', label: '내가 낼 수 있는 공고 찾기' }}>
  <section style="margin-top:0">
    <p class="sub" style="margin:0">지금 접수 중인 공고</p>
    <div class="big"><span data-hist={JSON.stringify(hist)} data-total={String(listings.length)}>{String(listings.length).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</span>건</div>
  </section>

  <section aria-labelledby="soon-h" style="margin-top:16px">
    <h2 id="soon-h">마감 임박</h2>
    <ListingList items={soon} group="soon" cap={5} />
    <div class="rows"><a class="row" href={weeks.includes(thisWeek) ? `/w/${thisWeek}/` : '/week/'}><span class="rt"><b>마감 임박 전체 보기</b><span>이번 주 마감하는 공고를 마감순으로 봐요</span></span><Chevron /></a></div>
  </section>

  <section class="rows door" aria-label="토스 앱"><TossMiniappLink /></section>

  <section>
    <h2>분류별로 보기</h2>
    <div class="grid2">
      {categories.map((c) => <a class="tile" href={`/c/${c.slug}/`}><b>{c.name}</b><span>{c.blurb}</span></a>)}
      {index.rolling.length > 0 && <a class="tile" href="/rolling/"><b>상시 모집</b><span>마감일 없이 수시로 받는 공고</span></a>}
    </div>
  </section>

  <section>
    <h2>누구를 위한 공고인가요</h2>
    <ul class="chips">{tags.map((t) => <li><a class="chip" href={`/t/${t.slug}/`}>{t.name}</a></li>)}</ul>
  </section>

  <section class="rows">
    <a class="row" href="/week/"><span class="rt"><b>주별로 보기 · 캘린더로 받기</b><span>이번 주 창업 공고와 마감 주별 목록이 있어요</span></span><Chevron /></a>
  </section>
</Layout>
