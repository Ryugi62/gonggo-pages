---
import IndexPage from '../../components/IndexPage.astro';
import { week, weeks } from '../../adapters/site/data.ts';
import CalendarSubscribe from '../../components/CalendarSubscribe.astro';
import { weekLabel } from '../../domain/format.ts';
import { formatDate } from '../../domain/format.ts';
import SubscribeEntry from '../../components/SubscribeEntry.astro';
import { IS_AWS } from '../../infrastructure/config.ts';
const heading = '이번 주 낼 수 있는 창업경진대회·지원사업';
const range = `${formatDate(week.from)} ~ ${formatDate(week.to)}`;
---
<IndexPage heading={heading} title={`${heading} ${week.items.length}건 | 공고콕`}
  description={`${range} 마감 창업경진대회·지원사업 ${week.items.length}건. 자격·업력·AI 사용 조항을 원문 그대로 정리했어요.`}
  path="/week/" lead={`${range}에 마감하는 창업 공고예요.${week.aiForbidden ? ` 이 중 ${week.aiForbidden}건은 AI 초안을 낼 수 없어요.` : ''}`} items={week.items} feed="founder-week">
  {IS_AWS && <div class="rows"><SubscribeEntry /></div>}
  <details class="fold" style="margin-top:24px">
    <summary>마감 주별로 보기</summary>
    <ul class="chips" style="margin-top:8px">{weeks.map((w) => <li><a class="chip gray" href={`/w/${w}/`}>{w.slice(0, 4)}년 {weekLabel(w)}</a></li>)}</ul>
  </details>
  <details class="fold" style="margin-top:8px">
    <summary>전체 마감을 캘린더로 받기</summary>
    <CalendarSubscribe feed="all" />
  </details>
  <details>
    <summary>어떤 공고를 모았나요</summary>
    <p class="sub">지원사업, 창업자 대상 공고, 이름에 창업·스타트업이 들어간 공고 중 7일 안에 마감하는 것만 모았어요. 매주 새로 만들어요. 지원 전 원문 공고를 꼭 확인해 주세요.</p>
  </details>
</IndexPage>
