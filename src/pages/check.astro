---
import Layout from '../layouts/Layout.astro';
import { REGIONS } from '../domain/eligibility.ts';
import { listings } from '../adapters/site/data.ts';
---
<Layout title="내가 낼 수 있는 공고 찾기 — 나이·학생·지역·사업자로 거르기 | 공고콕"
  description={`나이, 대학생 여부, 사는 지역, 사업자 여부만 고르면 접수 중인 공고 ${listings.length}건 중 낼 수 있는 공고를 골라 드려요. 입력값은 브라우저 밖으로 나가지 않아요.`}
  path="/check/">
  <div id="checker" class="has-own-cta">
    <p class="small" id="progress" aria-live="polite">1 / 2</p>

    <form id="step1" class="step" onsubmit="return false">
      <h1>나이와 학생 여부를 알려 주세요</h1>
      <label class="field">
        <span>만 나이</span>
        <input id="age" type="number" inputmode="numeric" min="10" max="99" placeholder="예: 24" />
        <small class="small">모르면 비워도 돼요</small>
      </label>
      <fieldset class="field">
        <legend>대학(원)생인가요?</legend>
        <div class="seg">
          <label><input type="radio" name="student" value="yes" /><span>네, 학생이에요</span></label>
          <label><input type="radio" name="student" value="no" /><span>아니에요</span></label>
        </div>
      </fieldset>
    </form>

    <form id="step2" class="step" hidden onsubmit="return false">
      <h1>지역과 사업자 여부를 알려 주세요</h1>
      <label class="field">
        <span>사는 곳(사업장 소재지)</span>
        <select id="region">
          <option value="">선택 안 함</option>
          {REGIONS.map((r) => <option value={r}>{r}</option>)}
        </select>
        <small class="small">지역 제한이 있는 공고만 걸러요</small>
      </label>
      <fieldset class="field">
        <legend>사업자 상태</legend>
        <div class="seg three">
          <label><input type="radio" name="biz" value="없음" /><span>없어요</span></label>
          <label><input type="radio" name="biz" value="예비창업" /><span>예비창업</span></label>
          <label><input type="radio" name="biz" value="사업자" /><span>사업자 있음</span></label>
        </div>
      </fieldset>
    </form>

    <div id="result" hidden>
      <section class="card" style="margin-top:0">
        <p class="sub" style="margin:0">낼 수 있는 공고</p>
        <div class="big" id="n-ok">0개</div>
        <p style="margin:6px 0 0" class="sub" id="n-rest"></p>
      </section>
      <section>
        <div class="seg" role="tablist">
          <label><input type="radio" name="view" value="맞음" checked /><span id="tab-ok">맞음</span></label>
          <label><input type="radio" name="view" value="확인 필요" /><span id="tab-unk">확인 필요</span></label>
        </div>
        <ul class="list" id="out" style="margin-top:16px"></ul>
      </section>
      <details>
        <summary>어떻게 골랐나요</summary>
        <p class="sub">공고 원문의 자격 문장에 적힌 나이·대학생·지역·사업자 조건만 비교했어요. 문장에 조건이 없거나 비워 둔 항목은 「확인 필요」로 남겨요. 입력값은 이 브라우저 안에서만 계산하고 저장하거나 보내지 않아요. 참고용이니 지원 전 원문 공고를 꼭 확인해 주세요.</p>
      </details>
    </div>
  </div>
  <div class="cta-bar"><button class="cta" style="width:100%;border:0;font-family:inherit;cursor:pointer" id="next" type="button">다음</button></div>
</Layout>
<style>
  #checker { padding-bottom: 80px; }
  .step h1 { margin-bottom: 24px; }
  .field { display: block; border: 0; padding: 0; margin: 0 0 28px; }
  .field > span, .field legend { display: block; font-weight: 600; font-size: 15px; color: var(--sub); margin-bottom: 8px; padding: 0; }
  input[type='number'], select { width: 100%; height: 56px; border-radius: 16px; border: 1px solid var(--line); background: var(--card); color: var(--text); font-size: 18px; padding: 0 16px; font-family: inherit; }
  .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .seg.three { grid-template-columns: 1fr 1fr 1fr; }
  .seg label { position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; }
  .seg span { display: flex; align-items: center; justify-content: center; min-height: 52px; border-radius: 14px; background: var(--card); font-weight: 600; font-size: 15px; cursor: pointer; text-align: center; padding: 0 6px; }
  .seg input:checked + span { background: var(--blue-weak); color: var(--blue-text); box-shadow: inset 0 0 0 2px var(--blue); }
  .seg input:focus-visible + span { outline: 2px solid var(--blue); outline-offset: 2px; }
</style>
<script>
  import { matchListing, type Profile } from '../domain/match.ts';
  import type { Constraints } from '../domain/eligibility.ts';

  type Row = { s: string; n: string; c: string; d: string | null; p: string | null; k: Constraints };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let step = 1;
  let rows: Row[] | null = null;
  const load = fetch('/checker.json').then((r) => r.json()).then((j: Row[]) => (rows = j));

  const radio = (name: string) => (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement | null)?.value ?? null;
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date());
  const dd = (d: string | null) => {
    if (!d) return '상시';
    const n = Math.round((Date.parse(d + 'T12:00:00Z') - Date.parse(today + 'T12:00:00Z')) / 864e5);
    return n < 0 ? '마감' : n === 0 ? 'D-day' : `D-${n}`;
  };

  function profile(): Profile {
    const ageRaw = $<HTMLInputElement>('age').value.trim();
    const s = radio('student');
    return {
      age: ageRaw ? Number(ageRaw) : null,
      student: s === 'yes' ? true : s === 'no' ? false : null,
      region: $<HTMLSelectElement>('region').value || null,
      business: (radio('biz') as Profile['business']) ?? null,
    };
  }

  let groups: Record<string, Row[]> = {};
  function render(view: string) {
    const out = $<HTMLUListElement>('out');
    out.replaceChildren();
    for (const r of (groups[view] ?? []).filter((x) => dd(x.d) !== '마감')) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'item';
      a.href = `/g/${r.s}/`;
      const d = document.createElement('span');
      d.className = 'dd';
      d.textContent = dd(r.d);
      const box = document.createElement('span');
      const t = document.createElement('span');
      t.className = 't';
      t.textContent = r.n;
      const m = document.createElement('span');
      m.className = 'm';
      m.textContent = [r.c, r.p].filter(Boolean).join(' · ');
      box.append(t, m);
      a.append(d, box);
      li.append(a);
      out.append(li);
    }
  }

  async function showResult() {
    await load;
    const p = profile();
    groups = { 맞음: [], '확인 필요': [], '안 맞음': [] };
    for (const r of rows ?? []) groups[matchListing(r.k, p)].push(r);
    $('n-ok').textContent = `${groups['맞음'].length}개`;
    $('n-rest').textContent = `확인이 필요한 공고 ${groups['확인 필요'].length}개 · 조건이 안 맞는 공고 ${groups['안 맞음'].length}개는 숨겼어요`;
    $('tab-ok').textContent = `맞음 ${groups['맞음'].length}`;
    $('tab-unk').textContent = `확인 필요 ${groups['확인 필요'].length}`;
    render('맞음');
  }

  document.querySelectorAll('input[name="view"]').forEach((el) =>
    el.addEventListener('change', (e) => render((e.target as HTMLInputElement).value)),
  );

  $('next').addEventListener('click', async () => {
    if (step === 1) {
      $('step1').hidden = true;
      $('step2').hidden = false;
      $('progress').textContent = '2 / 2';
      $('next').textContent = '결과 보기';
      step = 2;
    } else if (step === 2) {
      $('step2').hidden = true;
      $('result').hidden = false;
      $('progress').textContent = '결과';
      $('next').textContent = '다시 고르기';
      step = 3;
      await showResult();
    } else {
      $('result').hidden = true;
      $('step1').hidden = false;
      $('progress').textContent = '1 / 2';
      $('next').textContent = '다음';
      step = 1;
    }
    window.scrollTo(0, 0);
  });
</script>
