---
import Layout from '../layouts/Layout.astro';
import { REGIONS } from '../domain/eligibility.ts';
import { listings } from '../adapters/site/data.ts';
---
<Layout title="내가 낼 수 있는 공고 찾기 — 나이·학생·지역·사업자로 거르기 | 공고콕"
  description={`나이, 대학생 여부, 사는 지역, 사업자 여부만 고르면 접수 중인 공고 ${listings.length}건 중 낼 수 있는 공고를 골라 드려요. 입력값은 브라우저 밖으로 나가지 않아요.`}
  path="/check/">
  <div id="checker" class="has-own-cta">
    <div class="topline">
      <p class="small" id="progress" aria-live="polite">1 / 2</p>
      <button class="back" id="back" type="button" hidden>이전</button>
    </div>

    <form id="step1" class="step" onsubmit="return false">
      <h1>나이와 학생 여부를 알려 주세요</h1>
      <label class="field">
        <span>만 나이</span>
        <input id="age" type="number" inputmode="numeric" min="10" max="99" placeholder="예: 24" />
        <small class="small">모르면 비워도 돼요</small>
      </label>
      <fieldset class="field">
        <legend>대학(원)생인가요?</legend>
        <div class="seg">
          <label><input type="radio" name="student" value="yes" /><span>네, 학생이에요</span></label>
          <label><input type="radio" name="student" value="no" /><span>아니에요</span></label>
        </div>
      </fieldset>
    </form>

    <form id="step2" class="step" hidden onsubmit="return false">
      <h1>지역과 사업자 여부를 알려 주세요</h1>
      <label class="field">
        <span>사는 곳(사업장 소재지)</span>
        <select id="region">
          <option value="">선택 안 함</option>
          {REGIONS.map((r) => <option value={r}>{r}</option>)}
        </select>
        <small class="small">지역 제한이 있는 공고만 걸러요</small>
      </label>
      <fieldset class="field">
        <legend>사업자 상태</legend>
        <div class="seg three">
          <label><input type="radio" name="biz" value="없음" /><span>없어요</span></label>
          <label><input type="radio" name="biz" value="예비창업" /><span>예비창업</span></label>
          <label><input type="radio" name="biz" value="사업자" /><span>사업자 있음</span></label>
        </div>
      </fieldset>
    </form>

    <div id="result" hidden>
      <section id="err" class="card" role="alert" hidden style="margin-top:0">
        <p id="err-msg" style="margin:0 0 12px"></p>
        <button class="btn secondary" id="retry" type="button">다시 불러오기</button>
      </section>
      <div id="result-body">
      <section class="card" style="margin-top:0">
        <p class="sub" style="margin:0">낼 수 있는 공고</p>
        <div class="big" id="n-ok">0건</div>
        <p style="margin:6px 0 0" class="sub" id="n-rest"></p>
      </section>
      <section>
        <div class="seg" role="tablist">
          <label><input type="radio" name="view" value="맞음" checked /><span id="tab-ok">맞음</span></label>
          <label><input type="radio" name="view" value="확인 필요" /><span id="tab-unk">확인 필요</span></label>
        </div>
        <p id="empty" class="sub" hidden style="margin-top:16px" aria-live="polite"></p>
        <ul class="rel rows" id="out" style="margin-top:16px"></ul>
      </section>
      <details>
        <summary>어떻게 골랐나요</summary>
        <p class="sub">공고 원문의 자격 문장에 적힌 나이·대학생·지역·사업자 조건만 비교했어요. 문장에 조건이 없거나 비워 둔 항목은 「확인 필요」로 남겨요. 입력값은 이 브라우저 안에서만 계산하고 저장하거나 보내지 않아요. 참고용이니 지원 전 원문 공고를 꼭 확인해 주세요.</p>
      </details>
      </div>
    </div>
  </div>
  <div class="cta-bar"><button class="cta" style="width:100%;border:0;font-family:inherit;cursor:pointer" id="next" type="button">다음</button></div>
</Layout>
<style>
  #checker { padding-bottom: 80px; }
  :global(body:has(.cta-bar)) { padding-bottom: 92px; } /* PC 푸터 링크가 고정 CTA에 가리지 않게(SPEC §35 AC-149) */
  .back { margin-bottom: 8px; }
  .topline { display: flex; align-items: center; justify-content: space-between; min-height: 52px; }
  .topline p { margin: 0; }
  .back { min-height: 44px; padding: 0 8px; border: 0; background: transparent; color: var(--sub); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; } /* 보조 글자 버튼(§37 AC-164) */
  .back[hidden] { display: none; }
  .step h1 { margin-bottom: 24px; }
  .field { display: block; border: 0; padding: 0; margin: 0 0 28px; }
  .field > span, .field legend { display: block; font-weight: 600; font-size: 15px; color: var(--sub); margin-bottom: 8px; padding: 0; }
  input[type='number'], select { width: 100%; height: 56px; border-radius: 16px; border: 1px solid var(--line); background: var(--card); color: var(--text); font-size: 18px; padding: 0 16px; font-family: inherit; }
  .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .seg.three { grid-template-columns: 1fr 1fr 1fr; }
  .seg label { position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; }
  .seg span { display: flex; align-items: center; justify-content: center; min-height: 52px; border-radius: 14px; background: var(--card); font-weight: 600; font-size: 15px; cursor: pointer; text-align: center; padding: 0 6px; }
  .seg input:checked + span { background: var(--btn); color: #fff; } /* 목록 칩(.chip.on)과 같은 채움 */
  .seg input:focus-visible + span { outline: 2px solid var(--blue); outline-offset: 2px; }
</style>
<script>
  import { type Profile } from '../domain/match.ts';
  import { dDayLabel, formatDate } from '../domain/format.ts';
  import { ERROR_COPY, isPastRow, checkerCounts, emptyCopy, groupRows, nextLabel, nextStep, prevStep, progressLabel, visibleRows, type CheckerRow, type CheckerStep, type Groups } from '../domain/checker.ts';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let step: CheckerStep = 1;
  let rows: CheckerRow[] | null = null;
  let groups: Groups = { 맞음: [], '확인 필요': [], '안 맞음': [] };
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date());
  const hm = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Seoul', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date());
  const load = () => fetch('/checker.json').then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); }).then((j: CheckerRow[]) => (rows = j.filter((r) => !isPastRow(r, today, hm))));
  let loading: Promise<CheckerRow[]> = load();
  loading.catch(() => {});

  const radio = (name: string) => (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement | null)?.value ?? null;
  function profile(): Profile {
    const ageRaw = $<HTMLInputElement>('age').value.trim();
    const s = radio('student');
    return {
      age: ageRaw ? Number(ageRaw) : null,
      student: s === 'yes' ? true : s === 'no' ? false : null,
      region: $<HTMLSelectElement>('region').value || null,
      business: (radio('biz') as Profile['business']) ?? null,
    };
  }

  function render(view: '맞음' | '확인 필요') {
    const out = $<HTMLUListElement>('out');
    out.replaceChildren();
    const list = visibleRows(groups, view, today);
    $('empty').hidden = list.length > 0;
    $('empty').textContent = emptyCopy(view);
    for (const r of list) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'row';
      a.href = `/g/${r.s}/`;
      // 목록 행과 같은 부품: 배지 + 제목 + 보조(분류·마감일·상금) — SPEC §35 AC-149
      const d = document.createElement('span');
      const dl = dDayLabel(r.d, today);
      d.className = `bd${dl === '마감' ? ' closed' : /^D-[0-3]$|^D-day$/.test(dl) ? ' soon' : ''}`;
      d.textContent = dl;
      const box = document.createElement('span');
      box.className = 'rt';
      const t = document.createElement('b');
      t.textContent = r.n;
      const m = document.createElement('span');
      m.textContent = [r.c, r.d ? `${formatDate(r.d)} 마감` : '상시 모집', r.p].filter(Boolean).join(' · ');
      box.append(t, m);
      a.append(d, box);
      li.append(a);
      out.append(li);
    }
  }

  async function showResult(): Promise<boolean> {
    try {
      await loading;
    } catch {
      $('err').hidden = false;
      $('result-body').hidden = true;
      $('err-msg').textContent = ERROR_COPY.message;
      return false;
    }
    $('err').hidden = true;
    $('result-body').hidden = false;
    groups = groupRows(rows ?? [], profile());
    const c = checkerCounts(groups);
    $('n-ok').textContent = c.ok;
    $('n-rest').textContent = c.rest;
    $('tab-ok').textContent = c.tabOk;
    $('tab-unk').textContent = c.tabUnknown;
    render('맞음');
    return true;
  }

  function paint() {
    $('step1').hidden = step !== 1;
    $('step2').hidden = step !== 2;
    $('result').hidden = step !== 3;
    $('progress').textContent = progressLabel(step);
    $('next').textContent = nextLabel(step);
    $('back').hidden = step === 1;
    document.querySelector('.cta-bar')!.toggleAttribute('hidden', step === 3); // 결과에서는 「이전」 하나만(SPEC §36 AC-158)
    window.scrollTo(0, 0);
  }

  document.querySelectorAll('input[name="view"]').forEach((el) =>
    el.addEventListener('change', (e) => render((e.target as HTMLInputElement).value as '맞음' | '확인 필요')),
  );

  // SPEC §34 AC-138 — 단계는 히스토리에 쌓는다(뒤로 = 한 단계씩), 결과에서 공고를 열고 돌아오면 결과·스크롤을 되살린다
  const KEY = 'gk_check';
  const view = () => ((document.querySelector('input[name="view"]:checked') as HTMLInputElement | null)?.value ?? '맞음') as '맞음' | '확인 필요';
  const save = () => { try { if (step === 3) sessionStorage.setItem(KEY, JSON.stringify({ age: $<HTMLInputElement>('age').value, student: radio('student'), region: $<HTMLSelectElement>('region').value, biz: radio('biz'), view: view(), y: window.scrollY })); } catch { /* 저장소가 막혀도 동작은 그대로 */ } };
  const pick = (name: string, v: string | null) => { if (v) { const el = document.querySelector(`input[name="${name}"][value="${v}"]`) as HTMLInputElement | null; if (el) el.checked = true; } };
  async function restore(): Promise<boolean> {
    let st: any = null;
    try { st = JSON.parse(sessionStorage.getItem(KEY) ?? 'null'); } catch { st = null; }
    if (!st) return false;
    $<HTMLInputElement>('age').value = st.age ?? '';
    pick('student', st.student); pick('biz', st.biz);
    $<HTMLSelectElement>('region').value = st.region ?? '';
    step = 3; paint();
    if (!(await showResult())) return true;
    pick('view', st.view); render(st.view === '확인 필요' ? '확인 필요' : '맞음');
    requestAnimationFrame(() => window.scrollTo(0, st.y || 0));
    return true;
  }
  $('out').addEventListener('click', save);
  window.addEventListener('pagehide', save);
  window.addEventListener('popstate', async (e) => {
    const n = ((e.state as { step?: CheckerStep } | null)?.step ?? 1) as CheckerStep;
    step = n; paint();
    if (n === 3) await showResult();
  });
  if (location.hash === '#s3') { history.replaceState({ step: 3 }, ''); restore().then((ok) => { if (!ok) { step = 1; history.replaceState({ step: 1 }, '', location.pathname); paint(); } }); }
  else history.replaceState({ step: 1 }, '');

  $('back').addEventListener('click', () => { if (history.state && history.state.step > 1) history.back(); else { step = prevStep(step); paint(); } });
  $('retry').addEventListener('click', async () => {
    loading = load();
    loading.catch(() => {});
    await showResult();
  });
  $('next').addEventListener('click', async () => {
    step = nextStep(step);
    history.pushState({ step }, '', step === 1 ? location.pathname : `#s${step}`);
    paint();
    if (step === 3) {
      const ok = await showResult();
      if (!ok) $('retry').focus();
    }
  });
</script>
