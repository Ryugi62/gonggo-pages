---
import Layout from '../../layouts/Layout.astro';
import { aiOk, generatedAt } from '../../adapters/site/data.ts';
import { formatDate, dDayLabel } from '../../domain/format.ts';
import { proEntry } from '../../domain/proEntry.ts';
import { SITE_NAME, IS_AWS } from '../../infrastructure/config.ts';
export function getStaticPaths() {
  return [{ params: { date: generatedAt } }];
}
const heading = `AI 활용 허용 문장이 있는 마감 임박 공고 ${aiOk.length}건`;
const pro = proEntry('ai-ok');
const title = `${heading} (${formatDate(generatedAt)} 기준) | ${SITE_NAME}`;
const description = `${formatDate(generatedAt)} 기준 2주 안에 마감하고, 원문에 AI 활용을 허용하는 문장이 있는 공고 ${aiOk.length}건. 원문 인용 한 줄과 원문 링크를 마감 순으로 정리했어요.`;
const path = `/ai-ok/${generatedAt}/`;
const site = Astro.site!.href.replace(/\/$/, '');
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'ItemList', numberOfItems: aiOk.length,
  itemListElement: aiOk.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site}/g/${x.listing.slug}/`, name: x.listing.name })) }];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd} bottomCta={{ href: '/check/', label: '내가 낼 수 있는 공고 찾기' }}>
  <nav class="crumb" aria-label="위치"><a href="/">홈</a></nav>
  <h1>{heading}</h1>
  <p class="sub">{formatDate(generatedAt)} 기준, 2주 안에 마감하는 공고 중 원문에 AI 활용을 허용하는 문장이 있는 것만 마감 순으로 모았어요. 인용은 원문 일부이고, 조건과 마감은 원문 공고가 기준이니 지원 전에 꼭 다시 확인해 주세요.</p>
  <ol class="digest">
    {aiOk.map((x) => (
      <li style="margin:16px 0">
        <b><a href={`/g/${x.listing.slug}/`}>{x.listing.name}</a></b><br />
        <span class="sub">{formatDate(x.listing.deadline!)} 마감 ({dDayLabel(x.listing.deadline, generatedAt)}) · {x.listing.category}</span><br />
        <q>{x.quote}</q><br />
        <a href={x.listing.url} rel="noopener nofollow" target="_blank">원문 공고 보기</a>
      </li>
    ))}
  </ol>
  <p class="sub">공고 목록은 매주 새로 만들어요. 마감 임박 대학생·청년 공고는 <a href={`/digest/${generatedAt}/`}>이번 주 요약</a>에서 볼 수 있어요.</p>
  {IS_AWS && <section><a class="tile" href={pro.href}><b>{pro.title}</b><span>{pro.sub}</span></a></section>}
</Layout>
