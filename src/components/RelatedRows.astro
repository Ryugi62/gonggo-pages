---
// SPEC §31·§34 — 비슷한 공고·목록 행: 구분선 행(TDS ListRow) + D-day 배지. 행마다 마감일을 달아 날이 지나면 화면에서 걷는다(DAY_SCRIPT).
import type { PublicListing } from '../domain/listing.ts';
import { badgeState, deadlineTimeOf } from '../domain/freshness.ts';
import { displayTitle } from '../domain/displayText.ts';
import { formatDate } from '../domain/format.ts';
import { today, nowHM } from '../adapters/site/data.ts';
interface Props { items: PublicListing[]; group?: string; cap?: number }
const { items, group = 'rel', cap } = Astro.props;
const meta = (l: PublicListing) => [l.category, l.deadline ? `${formatDate(l.deadline)}${deadlineTimeOf(l.deadlineTime) ? ` ${deadlineTimeOf(l.deadlineTime)}` : ''} 마감` : '상시 모집', l.prize].filter(Boolean).join(' · ');
---
<ul class="rel rows" data-rows={group}>
  {items.map((l) => {
    const b = l.deadline ? badgeState(l.deadline, today, false, l.deadlineTime, nowHM) : null;
    return (
    <li data-row-deadline={l.deadline ?? '9999-12-31'} data-group={group} data-cap={cap ? String(cap) : undefined} data-row-time={deadlineTimeOf(l.deadlineTime) ?? undefined} data-tags={l.tags.join(',')}>
      <a class="row" href={`/g/${l.slug}/`}>
        {b ? <span class={`bd ${b.closed ? 'closed' : b.soon ? 'soon' : ''}`} data-deadline={l.deadline} data-deadline-time={deadlineTimeOf(l.deadlineTime) ?? undefined}>{b.label}</span> : <span class="bd">상시</span>}
        <span class="rt"><b>{displayTitle(l.name)}</b><span>{meta(l)}</span></span>
      </a>
    </li>
  );})}
</ul>
