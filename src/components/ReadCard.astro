---
// SPEC §29·§30·§32 — 「읽는 법」 4칸. 칸마다 구분선 목록 행 1개(제목 17 · 본문 15 · 보조 13, 3단). 읽는 법 화면(/g/<slug>/read/) 전용.
import type { ReadCard } from '../domain/readCard.ts';
import { AXES } from '../domain/readCard.ts';
import type { Axis } from '../domain/readCard.ts';
interface Props { card: ReadCard; facts?: Record<Axis, string> }
const { card, facts } = Astro.props;
---
<section id="read-card" aria-label="읽는 법 4칸" class="rc">
  {AXES.map((a) => (
    <div class="rc-row">
      <h3>{a.label}</h3>
      {facts && facts[a.key] && <p class="rc-fact">{facts[a.key]}</p>}
      <p class="rc-line">{card.axes[a.key].line}</p>
      <p class="rc-small">{card.axes[a.key].check.join(' · ')}</p>
    </div>
  ))}
</section>
<style is:global>
  .rc { margin-top: 24px; }
  .rc-row { padding: 16px 0; border-top: 1px solid var(--line); }
  .rc-row:first-child { border-top: 0; padding-top: 0; }
  .rc-row h3 { margin: 0 0 4px; font-size: 17px; line-height: 1.4; font-weight: 700; }
  .rc-fact { margin: 0 0 4px; font-size: 15px; line-height: 1.5; font-weight: 600; color: var(--text); }
  .rc-line { margin: 0; font-size: 15px; line-height: 1.5; color: var(--sub); }
  .rc-small { margin: 4px 0 0; font-size: 13px; line-height: 1.5; color: var(--muted); }
</style>
