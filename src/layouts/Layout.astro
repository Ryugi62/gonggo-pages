---
import { SITE_NAME, REPO_URL, IS_AWS } from '../infrastructure/config.ts';
import { generatedAt } from '../adapters/site/data.ts';
import LegalFooter from '../components/LegalFooter.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
  bottomCta?: { href: string; label: string; external?: boolean; attrs?: Record<string, string | undefined> };
  /** canonical 호스트를 바꿀 때(Pro 4장 = AWS 주소, SPEC §12) */
  origin?: string;
  /** Vercel 분석 스크립트 — AWS 빌드엔 없다(정식 주소는 va → 같은 출처 /intent/ 비콘, SPEC §13 R4) */
  analytics?: boolean;
  /** 사업자 정보·약관 링크(Pro 4장) */
  legal?: boolean;
}
const { title, description, path, jsonLd = [], noindex = false, bottomCta, origin, analytics = true, legal = false } = Astro.props;
const canonical = new URL(path, origin ?? Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#3182F6" />
  <meta name="naver-site-verification" content="b075ec90d3f456a4ecbac88671fff441169d5b8b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  {IS_AWS
    ? <script is:inline>window.va=function(e,o){var p=o&&o.path;if(e==='pageview'&&typeof p==='string'&&p.indexOf('/intent/')===0)try{fetch(p,{method:'GET',keepalive:true,credentials:'omit'})}catch(x){}};</script>
    : <script is:inline>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};</script>}
  {analytics && !IS_AWS && <script is:inline defer src="/_vercel/insights/script.js"></script>}
</head>
<body class={bottomCta ? 'has-cta' : ''}>
  <header class="top">
    <div class="wrap top-in">
      <a class="brand" href="/" aria-label={`${SITE_NAME} 홈`}><span class="dot" aria-hidden="true"></span>{SITE_NAME}</a>
      <nav aria-label="주요 메뉴"><a href="/check/">내가 낼 수 있나?</a></nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap">
      <p><strong>{SITE_NAME}은 공고 안내 페이지예요. 공고를 주최하거나 접수하지 않아요.</strong></p>
      <p>자격·마감·상금은 공개된 공고 원문을 요약·인용한 것이라 바뀌거나 틀릴 수 있어요. 지원 전에 반드시 원문 공고를 확인해 주세요. 원문과 다르면 원문이 맞아요.</p>
      <p>정리 기준일 {generatedAt} · <a href="/about/">정리 기준</a> · <a href={`${REPO_URL}/issues`} rel="noopener">정정 요청</a></p>
      {legal && <LegalFooter />}
    </div>
  </footer>
  {bottomCta && (
    <div class="cta-bar">
      <a class="cta" href={bottomCta.href} {...(bottomCta.external ? { target: '_blank', rel: 'noopener' } : {})} {...(bottomCta.attrs ?? {})}>{bottomCta.label}</a>
    </div>
  )}
  <button type="button" class="to-top" aria-label="맨 위로" hidden><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
  <script is:inline>
    // 사용자가 직접 올린 스크롤(터치·휠·키·마우스)에만 나타난다 — 탭 하이라이트·복원 같은 프로그램 스크롤엔 안 나온다(11/22 검수)
    (function(){var b=document.querySelector('.to-top');if(!b)return;var y0=window.scrollY,vh=window.innerHeight,u=0;['touchstart','touchmove','wheel','keydown','pointerdown'].forEach(function(n){window.addEventListener(n,function(){u=Date.now()},{passive:true})});window.addEventListener('scroll',function(){var y=window.scrollY;if(y<=vh||y>y0)b.hidden=true;else if(y<y0&&Date.now()-u<1500)b.hidden=false;y0=y},{passive:true});b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});b.hidden=true})})();
  </script>
  <script is:inline>
    // 토스 앱 링크: 휴대폰에서는 공고별 딥링크(intoss://…)를 먼저 열고, 1.5초 안에 앱이 안 열리면 같은 탭에서 기본 링크로 간다. PC·딥링크 없는 공고는 기본 링크 그대로.
    document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('a[data-intoss]');if(!a||!/Android|iPhone|iPad|iPod/i.test(navigator.userAgent))return;e.preventDefault();var fb=a.href,t=setTimeout(function(){location.href=fb},1500);document.addEventListener('visibilitychange',function(){if(document.hidden)clearTimeout(t)},{once:true});try{navigator.sendBeacon(a.getAttribute('ping')||'/intent/app-card')}catch(x){}location.href=a.getAttribute('data-intoss')});
  </script>
  <script is:inline>
    document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('[data-intent]');if(!a)return;try{window.va&&window.va('pageview',{route:'/intent/cal',path:a.getAttribute('data-intent')})}catch(x){}});
  </script>
  <script is:inline>
    (function(){var t=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Seoul'}).format(new Date());var at=function(d){return Date.parse(d+'T12:00:00Z')};document.querySelectorAll('[data-deadline]').forEach(function(el){var n=Math.round((at(el.getAttribute('data-deadline'))-at(t))/864e5);el.textContent=n<0?'마감':n===0?'D-day':'D-'+n;if(n<0)el.classList.add('closed')})})();
  </script>
</body>
</html>
<style is:global>
  :root {
    --bg: #ffffff; --text: #191f28; --sub: #4e5968; --muted: #5f6b78; --btn: #1f6ce0; --line: #e5e8eb; --card: #f2f4f6;
    --blue: #3182f6; --card-hover: #e5e8eb; --blue-weak: #e8f3ff; --blue-text: #1b64da; --ok: #087f5b; --warn: #9c4f00; --no: #c62828;
    --ok-bg: #e6fcf5; --ok-fg: #087f5b; --no-bg: #ffebee; --no-fg: #c62828;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #17171c; --text: #ececee; --sub: #b0b8c1; --muted: #9ea7b2; --line: #2c2c35; --card: #222229;
      --blue: #4c93ff; --card-hover: #2c2c35; --btn: #1f6ce0; --blue-weak: #1d2a40; --blue-text: #8bb8ff; --ok: #3ecf8e; --warn: #ffb35c; --no: #ff6b78;
      --ok-bg: #12382b; --ok-fg: #3ecf8e; --no-bg: #3a1a20; --no-fg: #ff8a95; }
  }
  * { box-sizing: border-box; }
  .to-top { position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); color: var(--text); cursor: pointer; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 0; }
  .to-top[hidden] { display: none; }
  body:has(.cta-bar) .to-top { bottom: calc(88px + env(safe-area-inset-bottom)); }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Pretendard', 'Malgun Gothic', system-ui, sans-serif; word-break: keep-all; overflow-wrap: anywhere; }
  body.has-cta { padding-bottom: 92px; }
  a { color: var(--blue-text); }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  .top { position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--line); background: var(--bg); }
  .top-in { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { font-weight: 800; font-size: 18px; color: var(--text); text-decoration: none; display: flex; align-items: center; gap: 8px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--blue); display: inline-block; }
  .top nav a { font-size: 15px; font-weight: 600; text-decoration: none; padding: 12px 0; display: inline-block; }
  main { padding-top: 24px; padding-bottom: 32px; }
  h1 { font-size: 24px; line-height: 1.35; margin: 8px 0 8px; font-weight: 700; }
  h2 { font-size: 20px; margin: 0 0 12px; font-weight: 700; }
  section { margin-top: 32px; }
  .sub { color: var(--sub); font-size: 15px; margin: 0; }
  .lead { margin: 8px 0 0; font-size: 16px; line-height: 1.55; }
  .clause-preview { margin: 12px 0 0; padding: 12px 16px; border-radius: 12px; background: var(--card); font-size: 14px; line-height: 1.55; }
  .small { color: var(--muted); font-size: 13px; }
  .crumb { font-size: 13px; color: var(--muted); }
  .crumb a { color: var(--muted); text-decoration: none; }
  .card { background: var(--card); border-radius: 16px; padding: 20px; }
  .big { font-size: 32px; font-weight: 800; line-height: 1.2; letter-spacing: -0.5px; }
  .big.closed { color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .chip { display: inline-block; padding: 8px 12px; border-radius: 999px; background: var(--blue-weak); color: var(--blue-text); font-size: 13px; font-weight: 600; text-decoration: none; }
  .chip.gray { background: var(--card); color: var(--sub); }
  .badge { display: inline-block; padding: 8px 12px; border-radius: 8px; font-size: 14px; font-weight: 700; margin: 0; }
  .badge.no { background: var(--no-bg); color: var(--no-fg); }
  .badge.ok { background: var(--ok-bg); color: var(--ok-fg); }
  .clauses { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .clauses li { background: var(--card); border-radius: 16px; padding: 16px; }
  .clauses .ck { display: block; font-size: 13px; font-weight: 700; color: var(--sub); margin-bottom: 4px; }
  .clauses q { quotes: '「' '」'; }
  .cq { font-size: 15px; font-weight: 700; margin: 0 0 4px; }
  .clauses .cq { display: block; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .item { display: flex; gap: 12px; align-items: center; padding: 16px; border-radius: 16px; background: var(--card); text-decoration: none; color: var(--text); min-height: 56px; }
  .item .dd { min-width: 64px; font-weight: 800; font-size: 17px; color: var(--blue-text); }
  .item .dd.closed { color: var(--muted); }
  .item .t { font-weight: 600; font-size: 16px; line-height: 1.4; display: block; }
  .item .m { font-size: 13px; color: var(--muted); display: block; margin-top: 4px; }
  blockquote { margin: 12px 0 0; padding: 16px 20px; border-left: 4px solid var(--blue); background: var(--card); border-radius: 0 16px 16px 0; font-size: 16px; }
  dl.facts { display: grid; grid-template-columns: 88px 1fr; gap: 8px 12px; margin: 0; }
  dl.facts dt { color: var(--muted); font-size: 15px; }
  dl.facts dd { margin: 0; font-size: 16px; }
  details { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 16px; }
  summary { cursor: pointer; color: var(--sub); font-size: 15px; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .btn { display: inline-flex; justify-content: center; align-items: center; min-height: 52px; padding: 0 20px; border-radius: 16px; font-size: 16px; font-weight: 700; border: 0; cursor: pointer; text-decoration: none; font-family: inherit; }
  .btn.primary { background: var(--btn); color: #fff; }
  .btn.secondary { background: var(--blue-weak); color: var(--blue-text); }
  .btn.block { width: 100%; }
  .cta-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px 20px calc(12px + env(safe-area-inset-bottom)); background: linear-gradient(to top, var(--bg) 70%, transparent); }
  .cta { display: flex; justify-content: center; align-items: center; height: 56px; max-width: 680px; margin: 0 auto; border-radius: 16px; background: var(--btn); color: #fff; font-size: 17px; font-weight: 700; text-decoration: none; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tile { display: block; padding: 16px 20px; border-radius: 16px; background: var(--card); text-decoration: none; color: var(--text); }
  .tile b { display: block; font-size: 17px; }
  .tile span { font-size: 13px; color: var(--muted); }
  .foot { border-top: 1px solid var(--line); margin-top: 40px; padding: 24px 0 32px; color: var(--muted); font-size: 13px; }
  .foot p { margin: 0 0 8px; }
  .foot strong { color: var(--sub); }
  .foot a { color: var(--muted); }
  /* ListRow — 하단 「더 해 볼 수 있어요」 묶음·읽는 법 진입 (TDS ListRow 대응: 제목 16 · 보조 13 · 오른쪽 화살표 24) */
  .rows { margin: 24px 0 0; }
  #more-h + .rows { margin-top: 0; }
  .row { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 64px; padding: 16px 0; border: 0; border-top: 1px solid var(--line); background: transparent; color: var(--text); text-decoration: none; font: inherit; text-align: left; cursor: pointer; }
  .rows > :first-child .row, .rows > .row:first-child { border-top: 0; }
  .row .rt { flex: 1; min-width: 0; }
  .row .rt b { display: block; font-size: 16px; line-height: 1.4; }
  .row .rt span { display: block; font-size: 13px; color: var(--muted); margin-top: 4px; }
  .row .go { flex: none; color: var(--muted); }
  .row .ic { flex: none; width: 40px; height: 40px; }
  .rows > section { margin-top: 0; }
  /* 반응: 호버는 마우스 기기에서만, 눌림은 모든 기기 */
  .tile, .row, .item, .btn, .cta, .to-top, .chip { transition: background-color .15s ease, transform .1s ease, color .15s ease; -webkit-tap-highlight-color: transparent; }
  .row .go { transition: transform .15s ease; }
  .tile:active, .row:active, .item:active, .btn:active, .cta:active, .to-top:active, .chip:active { transform: scale(0.98); }
  .row:active .rt b { color: var(--blue-text); }
  @media (hover: hover) {
    .tile:hover, .item:hover { background: var(--card-hover); }
    .row:hover .rt b { color: var(--blue-text); }
    .row:hover .go { transform: translateX(4px); }
    .btn.secondary:hover { filter: brightness(0.96); }
    .cta:hover { filter: brightness(0.92); }
    .to-top:hover { background: var(--card); }
    .chip:hover { filter: brightness(0.95); }
  }
  @media (min-width: 960px) { h1 { font-size: 28px; } }
</style>
