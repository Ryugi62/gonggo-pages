---
import { SITE_NAME, REPO_URL, IS_AWS } from '../infrastructure/config.ts';
import { generatedAt } from '../adapters/site/data.ts';
import LegalFooter from '../components/LegalFooter.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
  bottomCta?: { href: string; label: string; external?: boolean };
  /** canonical 호스트를 바꿀 때(Pro 4장 = AWS 주소, SPEC §12) */
  origin?: string;
  /** Vercel 분석 스크립트 — AWS 빌드엔 없다(정식 주소는 va → 같은 출처 /intent/ 비콘, SPEC §13 R4) */
  analytics?: boolean;
  /** 사업자 정보·약관 링크(Pro 4장) */
  legal?: boolean;
}
const { title, description, path, jsonLd = [], noindex = false, bottomCta, origin, analytics = true, legal = false } = Astro.props;
const canonical = new URL(path, origin ?? Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#3182F6" />
  <meta name="naver-site-verification" content="b075ec90d3f456a4ecbac88671fff441169d5b8b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  {IS_AWS
    ? <script is:inline>window.va=function(e,o){var p=o&&o.path;if(e==='pageview'&&typeof p==='string'&&p.indexOf('/intent/')===0)try{fetch(p,{method:'GET',keepalive:true,credentials:'omit'})}catch(x){}};</script>
    : <script is:inline>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};</script>}
  {analytics && !IS_AWS && <script is:inline defer src="/_vercel/insights/script.js"></script>}
</head>
<body class={bottomCta ? 'has-cta' : ''}>
  <header class="top">
    <div class="wrap top-in">
      <a class="brand" href="/" aria-label={`${SITE_NAME} 홈`}><span class="dot" aria-hidden="true"></span>{SITE_NAME}</a>
      <nav aria-label="주요 메뉴"><a href="/check/">내가 낼 수 있나?</a></nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap">
      <p><strong>{SITE_NAME}는 공고 안내 페이지예요. 공고를 주최하거나 접수하지 않아요.</strong></p>
      <p>자격·마감·상금은 공개된 공고 원문을 요약·인용한 것이라 바뀌거나 틀릴 수 있어요. 지원 전에 반드시 원문 공고를 확인해 주세요. 원문과 다르면 원문이 맞아요.</p>
      <p>정리 기준일 {generatedAt} · <a href="/about/">정리 기준</a> · <a href={`${REPO_URL}/issues`} rel="noopener">정정 요청</a></p>
      {legal && <LegalFooter />}
    </div>
  </footer>
  {bottomCta && (
    <div class="cta-bar">
      <a class="cta" href={bottomCta.href} {...(bottomCta.external ? { target: '_blank', rel: 'noopener' } : {})}>{bottomCta.label}</a>
    </div>
  )}
  <script is:inline>
    document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('[data-intent]');if(!a)return;try{window.va&&window.va('pageview',{route:'/intent/cal',path:a.getAttribute('data-intent')})}catch(x){}});
  </script>
  <script is:inline>
    (function(){var t=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Seoul'}).format(new Date());var at=function(d){return Date.parse(d+'T12:00:00Z')};document.querySelectorAll('[data-deadline]').forEach(function(el){var n=Math.round((at(el.getAttribute('data-deadline'))-at(t))/864e5);el.textContent=n<0?'마감':n===0?'D-day':'D-'+n;if(n<0)el.classList.add('closed')})})();
  </script>
</body>
</html>
<style is:global>
  :root {
    --bg: #ffffff; --text: #191f28; --sub: #4e5968; --muted: #5f6b78; --btn: #1f6ce0; --line: #e5e8eb; --card: #f2f4f6;
    --blue: #3182f6; --blue-weak: #e8f3ff; --blue-text: #1b64da; --ok: #0a7a4b; --warn: #a35200; --no: #d22030;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #17171c; --text: #ececee; --sub: #b0b8c1; --muted: #9ea7b2; --line: #2c2c35; --card: #222229;
      --blue: #4c93ff; --btn: #1f6ce0; --blue-weak: #1d2a40; --blue-text: #8bb8ff; --ok: #3ecf8e; --warn: #ffb35c; --no: #ff6b78; }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Pretendard', 'Malgun Gothic', system-ui, sans-serif; word-break: keep-all; overflow-wrap: anywhere; }
  body.has-cta { padding-bottom: 92px; }
  a { color: var(--blue-text); }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  .top { border-bottom: 1px solid var(--line); background: var(--bg); }
  .top-in { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { font-weight: 800; font-size: 18px; color: var(--text); text-decoration: none; display: flex; align-items: center; gap: 8px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--blue); display: inline-block; }
  .top nav a { font-size: 15px; font-weight: 600; text-decoration: none; padding: 12px 0; display: inline-block; }
  main { padding-top: 24px; padding-bottom: 32px; }
  h1 { font-size: 24px; line-height: 1.35; margin: 8px 0 8px; font-weight: 700; }
  h2 { font-size: 20px; margin: 0 0 12px; font-weight: 700; }
  section { margin-top: 32px; }
  .sub { color: var(--sub); font-size: 15px; margin: 0; }
  .small { color: var(--muted); font-size: 13px; }
  .crumb { font-size: 13px; color: var(--muted); }
  .crumb a { color: var(--muted); text-decoration: none; }
  .card { background: var(--card); border-radius: 16px; padding: 20px; }
  .big { font-size: 32px; font-weight: 800; line-height: 1.2; letter-spacing: -0.5px; }
  .big.closed { color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .chip { display: inline-block; padding: 6px 12px; border-radius: 999px; background: var(--blue-weak); color: var(--blue-text); font-size: 13px; font-weight: 600; text-decoration: none; }
  .chip.gray { background: var(--card); color: var(--sub); }
  .badge { display: inline-block; padding: 6px 12px; border-radius: 8px; font-size: 14px; font-weight: 700; margin: 0; }
  .badge.no { background: color-mix(in srgb, var(--no) 12%, transparent); color: var(--no); }
  .badge.ok { background: color-mix(in srgb, var(--ok) 12%, transparent); color: var(--ok); }
  .clauses { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .clauses li { background: var(--card); border-radius: 16px; padding: 14px 16px; }
  .clauses .ck { display: block; font-size: 13px; font-weight: 700; color: var(--sub); margin-bottom: 4px; }
  .clauses q { quotes: '「' '」'; }
  .cq { font-size: 15px; font-weight: 700; margin: 0 0 4px; }
  .clauses .cq { display: block; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .item { display: flex; gap: 14px; align-items: center; padding: 16px; border-radius: 16px; background: var(--card); text-decoration: none; color: var(--text); min-height: 56px; }
  .item .dd { min-width: 64px; font-weight: 800; font-size: 17px; color: var(--blue-text); }
  .item .dd.closed { color: var(--muted); }
  .item .t { font-weight: 600; font-size: 16px; line-height: 1.4; display: block; }
  .item .m { font-size: 13px; color: var(--muted); display: block; margin-top: 2px; }
  blockquote { margin: 12px 0 0; padding: 16px 18px; border-left: 4px solid var(--blue); background: var(--card); border-radius: 0 16px 16px 0; font-size: 16px; }
  dl.facts { display: grid; grid-template-columns: 88px 1fr; gap: 10px 12px; margin: 0; }
  dl.facts dt { color: var(--muted); font-size: 15px; }
  dl.facts dd { margin: 0; font-size: 16px; }
  details { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 16px; }
  summary { cursor: pointer; color: var(--sub); font-size: 15px; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .btn { display: inline-flex; justify-content: center; align-items: center; min-height: 52px; padding: 0 20px; border-radius: 16px; font-size: 16px; font-weight: 700; border: 0; cursor: pointer; text-decoration: none; font-family: inherit; }
  .btn.primary { background: var(--btn); color: #fff; }
  .btn.secondary { background: var(--blue-weak); color: var(--blue-text); }
  .btn.block { width: 100%; }
  .cta-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px 20px calc(12px + env(safe-area-inset-bottom)); background: linear-gradient(to top, var(--bg) 70%, transparent); }
  .cta { display: flex; justify-content: center; align-items: center; height: 56px; max-width: 680px; margin: 0 auto; border-radius: 16px; background: var(--btn); color: #fff; font-size: 17px; font-weight: 700; text-decoration: none; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tile { display: block; padding: 18px; border-radius: 16px; background: var(--card); text-decoration: none; color: var(--text); }
  .tile b { display: block; font-size: 17px; }
  .tile span { font-size: 13px; color: var(--muted); }
  .foot { border-top: 1px solid var(--line); margin-top: 40px; padding: 24px 0 32px; color: var(--muted); font-size: 13px; }
  .foot p { margin: 0 0 8px; }
  .foot strong { color: var(--sub); }
  .foot a { color: var(--muted); }
  @media (min-width: 960px) { h1 { font-size: 28px; } }
</style>
