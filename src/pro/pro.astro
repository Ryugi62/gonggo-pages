---
// SPEC §33 AC-130 — /pro/ 는 200을 유지하고(옛 링크·검색 기록), 가격·사전 신청 대신 앱 안내 1장 + 문 1개.
// 옛 가격·사전 신청 화면은 git 기록(4c82233)에 있다. 약관·환불·처리방침은 그대로.
import Layout from '../layouts/Layout.astro';
import { PRO_ORIGIN } from '../infrastructure/config.ts';
import { appDoor } from '../domain/tossLink.ts';

const d = appDoor();
const title = '공고콕, 토스 앱에서도 써 보세요 | 공고콕';
const description = '공고 자격·마감·상금은 이 사이트에서 무료로 볼 수 있고, 마감 임박순 공고 목록은 토스 앱 공고콕에서도 볼 수 있어요.';
---
<Layout title={title} description={description} path="/pro/" origin={PRO_ORIGIN} analytics={false} legal noindex bottomCta={{ href: d.href, label: d.label, external: true, note: d.pcNote, attrs: { ping: d.ping, 'data-intent': d.intent } }}>
  <h1>공고콕, 토스 앱에서도 써 보세요</h1>
  <p class="sub" style="margin-top:8px">앱에서는 이런 걸 볼 수 있어요.</p>
  <section class="rows" aria-label="앱에서 보는 것">
    <div class="row app-fact"><span class="rt"><b>마감 임박순 공고 목록</b><span>공고마다 D-day를 보여 줘요</span></span></div>
    <div class="row app-fact"><span class="rt"><b>공고마다 AI 사용 여부를 한눈에</b><span>공고별 「AI 분석」 표시로 확인해요</span></span></div>
    <div class="row app-fact"><span class="rt"><b>내 조건 저장</b><span>학생 여부·사는 곳을 골라 두면 목록에 반영돼요</span></span></div>
  </section>
  <section class="rows" aria-label="이어서 보기">
    <a class="row" href="/"><span class="rt"><b>지금 접수 중인 공고 보기</b><span>자격·마감·상금을 원문을 보고 정리했어요</span></span><svg class="go" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></a>
  </section>
</Layout>
